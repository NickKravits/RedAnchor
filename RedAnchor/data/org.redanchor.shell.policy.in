<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Сопряжение контроллера через кабель: оболочка запускает помощника через pkexec
     без запроса пароля, если пользователь сидит за консолью (активная сессия). -->
<policyconfig>
  <vendor>RedAnchor</vendor>
  <action id="org.redanchor.shell.pair-controller">
    <description>Pair a game controller connected over USB</description>
    <description xml:lang="ru">Сопряжение контроллера, подключённого по USB</description>
    <message>Authentication is required to pair the controller</message>
    <message xml:lang="ru">Для сопряжения контроллера требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@PAIR_HELPER_PATH@</annotate>
  </action>
  <!-- Установка драйверов и Vulkan из настроек и мастера настройки (фиксированный набор пакетов) -->
  <action id="org.redanchor.shell.components">
    <description>Install graphics drivers and Vulkan</description>
    <description xml:lang="ru">Установка графических драйверов и Vulkan</description>
    <message>Authentication is required to install system components</message>
    <message xml:lang="ru">Для установки системных компонентов требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@COMPONENTS_HELPER_PATH@</annotate>
  </action>
</policyconfig>
