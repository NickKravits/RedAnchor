#!/bin/sh
# Сессия RedAnchor: запускает оболочку на весь экран вместо GNOME.
# gamescope предпочтительнее — в нём же потом будут запускаться игры. Запасные варианты
# (нет gamescope или видеокарта ему не подходит, например в виртуальной машине):
# Weston в режиме киоска, затем cage. cage падает на окнах Xwayland (Steam), Weston — нет.
#
# Всё, что пишут композитор и оболочка, сохраняется в журнал:
#   ~/.local/state/redanchor/session.log  (прошлый запуск — session.log.old)
# Если сессия сразу возвращает на экран входа — причина там.

export XDG_CURRENT_DESKTOP=RedAnchor
export XDG_SESSION_DESKTOP=redanchor

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/redanchor"
LOG="$STATE_DIR/session.log"
mkdir -p "$STATE_DIR"
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.old"
exec >"$LOG" 2>&1

log() { echo "redanchor-session: $*"; }

log "$(date '+%F %T') старт, сеанс ${XDG_SESSION_TYPE:-?}, место ${XDG_SEAT:-?}, vt ${XDG_VTNR:-?}"

# Оболочка лежит рядом со скриптом; REDANCHOR_SHELL — чтобы подставить свою сборку
SHELL_BIN="${REDANCHOR_SHELL:-$(dirname "$(readlink -f "$0")")/redanchor-shell}"
if [ ! -x "$SHELL_BIN" ]; then
    SHELL_BIN="$(command -v redanchor-shell)"
fi
if [ -z "$SHELL_BIN" ] || [ ! -x "$SHELL_BIN" ]; then
    log "не найден redanchor-shell (выполните sudo cmake --install в каталоге сборки)"
    exit 1
fi
log "оболочка: $SHELL_BIN"

# Не хватает библиотек (Qt не найден) — сразу видно в журнале
MISSING="$(ldd "$SHELL_BIN" 2>/dev/null | grep 'not found')"
if [ -n "$MISSING" ]; then
    log "оболочке не хватает библиотек:"
    echo "$MISSING"
    exit 1
fi

# Оболочка при старте оставляет отметку (REDANCHOR_STARTED_FILE). Композитор завершился
# с ошибкой, а отметки нет — он не смог запуститься, пробуем следующий. Отметка есть —
# упал посреди работы: поднимаем сессию заново, а не выкидываем на экран входа.
STARTED="$STATE_DIR/shell.started"
EXIT_FILE="$STATE_DIR/shell.exit"
export REDANCHOR_STARTED_FILE="$STARTED"

try_run() {
    name="$1"
    shift
    command -v "$name" >/dev/null 2>&1 || { log "$name не установлен"; return 1; }
    log "запуск: $*"
    # Оболочка подстраивает запуск игр под композитор (cage — без Xwayland)
    export REDANCHOR_SESSION_COMPOSITOR="$name"
    restarts=0
    while :; do
        rm -f "$STARTED" "$EXIT_FILE"
        start=$(date +%s)
        "$@"
        code=$?
        # Weston сам всегда выходит с кодом 0 — код оболочки записывает её обёртка
        [ -s "$EXIT_FILE" ] && code=$(cat "$EXIT_FILE")
        elapsed=$(( $(date +%s) - start ))
        log "$name завершился с кодом $code через $elapsed с"
        # Обычный выход оболочки — сессия закончена
        [ "$code" = 0 ] && exit 0
        # 42 — сброс настроек (Настройки → О системе): оболочка уже закрыта, сбрасываем
        # и запускаем её заново (с первичной настройкой)
        if [ "$code" = 42 ]; then
            log "сброс настроек"
            "$(dirname "$(readlink -f "$0")")/redanchor-reset" --yes || log "сброс завершился с ошибкой"
            restarts=0
            continue
        fi
        # Оболочка так и не запустилась — пробуем следующий способ
        [ -f "$STARTED" ] || return 1
        # Упал посреди работы — поднимаем заново
        restarts=$((restarts + 1))
        if [ "$restarts" -gt 5 ]; then
            log "слишком много падений подряд, выходим"
            exit "$code"
        fi
        log "перезапуск ($restarts)"
    done
}

# Строка для sh в одинарных кавычках
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Weston (kiosk-shell): программу запускает сам из weston.ini ([autolaunch]) и выходит,
# когда она закрывается. Аргументов там не передать — пишем обёртку
run_weston() {
    software="$1"
    shift
    launcher="$STATE_DIR/weston-shell"
    {
        echo '#!/bin/sh'
        printf 'env QT_QPA_PLATFORM=wayland'
        [ -n "$software" ] && printf ' LIBGL_ALWAYS_SOFTWARE=1'
        printf ' %s --fullscreen' "$(quote "$SHELL_BIN")"
        for arg in "$@"; do printf ' %s' "$(quote "$arg")"; done
        echo
        printf 'echo $? > %s\n' "$(quote "$EXIT_FILE")"
    } >"$launcher"
    chmod +x "$launcher"
    cat >"$STATE_DIR/weston.ini" <<EOF
[core]
shell=kiosk
xwayland=true
idle-time=0

[autolaunch]
path=$launcher
watch=true
EOF
    if [ -n "$software" ]; then
        try_run weston weston --config="$STATE_DIR/weston.ini" --renderer=pixman
    else
        try_run weston weston --config="$STATE_DIR/weston.ini"
    fi
}

if [ -z "$REDANCHOR_COMPOSITOR" ] || [ "$REDANCHOR_COMPOSITOR" = gamescope ]; then
    # Внутри gamescope приложения работают через Xwayland (Qt нужен libxcb-cursor0)
    try_run gamescope gamescope -f -- env QT_QPA_PLATFORM=xcb "$SHELL_BIN" --fullscreen "$@"
fi
if [ -z "$REDANCHOR_COMPOSITOR" ] || [ "$REDANCHOR_COMPOSITOR" = weston ]; then
    run_weston "" "$@"
    # Нет 3D-ускорения — Weston рисует процессором, оболочка — программным OpenGL
    if command -v weston >/dev/null 2>&1; then
        log "Weston: пробуем без 3D-ускорения (программная отрисовка)"
        run_weston software "$@"
    fi
fi
if [ -z "$REDANCHOR_COMPOSITOR" ] || [ "$REDANCHOR_COMPOSITOR" = cage ]; then
    try_run cage cage -s -- env QT_QPA_PLATFORM=wayland "$SHELL_BIN" --fullscreen "$@"
    # Нет 3D-ускорения (виртуальная машина без него, нет драйвера видеокарты): композитор
    # рисует процессором, оболочка — через программный OpenGL (llvmpipe). Медленно, но работает.
    log "пробуем без 3D-ускорения (программная отрисовка)"
    export WLR_RENDERER=pixman
    try_run cage cage -s -- env QT_QPA_PLATFORM=wayland LIBGL_ALWAYS_SOFTWARE=1 \
        "$SHELL_BIN" --fullscreen "$@"
fi

log "не удалось запустить ни один композитор (нужен gamescope, Weston или cage)"
exit 1
