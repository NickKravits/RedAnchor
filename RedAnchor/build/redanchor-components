#!/bin/bash
# redanchor-components — установка системных компонентов RedAnchor (Ubuntu / Debian).
# Запускается от root через pkexec (правило polkit: data/org.redanchor.shell.policy.in).
#
#   redanchor-components vulkan    — загрузчик Vulkan и драйверы Mesa Vulkan (64 и 32 бита)
#   redanchor-components drivers   — графический драйвер: NVIDIA (ubuntu-drivers / nvidia-driver)
#                                    или Mesa для AMD и Intel (64 и 32 бита) с прошивками
#
# Вывод для оболочки: «PROGRESS <0..100> <текст>» и «REBOOT», если нужна перезагрузка.
# Остальной вывод apt уходит в stderr (журнал оболочки).

set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

progress() { echo "PROGRESS $1 $2"; }

# 32-битные библиотеки нужны Proton для старых игр
ensure_i386() {
    if ! dpkg --print-foreign-architectures | grep -qx i386; then
        progress 2 "Включение 32-битных пакетов"
        dpkg --add-architecture i386
    fi
}

apt_update() {
    progress 5 "Обновление списка пакетов"
    apt-get update -q >&2
}

# apt-get install с прогрессом: APT::Status-Fd выдаёт строки dlstatus/pmstatus
apt_install() {
    apt-get install -y -q \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        -o APT::Status-Fd=3 "$@" 3>&1 1>&2 |
    while IFS=: read -r kind item pct _; do
        p=${pct%%.*}
        p=${p:-0}
        case "$kind" in
            dlstatus) progress $((10 + p / 2)) "Загрузка пакетов" ;;
            pmstatus) progress $((60 + p * 39 / 100)) "Установка: ${item}" ;;
        esac
    done
    return "${PIPESTATUS[0]}"
}

gpu_vendor() {
    local vendor=""
    for dev in /sys/bus/pci/devices/*; do
        [[ $(cat "$dev/class") == 0x03* ]] || continue
        case $(cat "$dev/vendor") in
            0x10de) echo nvidia; return ;;
            0x1002) vendor=amd ;;
            0x8086) [[ -z $vendor ]] && vendor=intel ;;
        esac
    done
    echo "${vendor:-unknown}"
}

install_vulkan() {
    ensure_i386
    apt_update
    apt_install libvulkan1 libvulkan1:i386 mesa-vulkan-drivers mesa-vulkan-drivers:i386 vulkan-tools
}

install_drivers() {
    ensure_i386
    apt_update
    case "$(gpu_vendor)" in
        nvidia)
            if command -v ubuntu-drivers >/dev/null 2>&1; then
                progress 20 "Установка рекомендуемого драйвера NVIDIA"
                ubuntu-drivers install >&2
            else
                # Debian: драйвер из non-free
                apt_install nvidia-driver firmware-misc-nonfree
            fi
            # 32-битная часть драйвера для Proton
            local ver
            ver=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'nvidia-driver-*' 2>/dev/null |
                  sed -n 's/^ii *nvidia-driver-\([0-9]\+\).*/\1/p' | sort -n | tail -1)
            if [[ -n $ver ]]; then
                apt_install "libnvidia-gl-${ver}:i386"
            fi
            echo REBOOT
            ;;
        *)
            local firmware=linux-firmware
            apt-cache show linux-firmware >/dev/null 2>&1 || firmware=firmware-linux
            apt_install libgl1-mesa-dri libgl1-mesa-dri:i386 mesa-va-drivers "$firmware"
            ;;
    esac
}

case "${1:-}" in
    vulkan) install_vulkan ;;
    drivers) install_drivers ;;
    *) echo "usage: redanchor-components vulkan|drivers" >&2; exit 1 ;;
esac
progress 100 "Готово"
