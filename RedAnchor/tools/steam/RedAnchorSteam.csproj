<Project Sdk="Microsoft.NET.Sdk">

  <!-- redanchor-steam: библиотека и профиль Steam через SteamKit2 для оболочки RedAnchor -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Версия .NET: по умолчанию 8, CMake передаёт версию установленного SDK
         (-p:RedAnchorDotnetMajor=10). Через своё свойство, а не -p:TargetFramework:
         иначе восстановление пакетов идёт под другую версию (ошибка NETSDK1005). -->
    <RedAnchorDotnetMajor Condition="'$(RedAnchorDotnetMajor)' == ''">8</RedAnchorDotnetMajor>
    <TargetFramework>net$(RedAnchorDotnetMajor).0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>redanchor-steam</AssemblyName>
    <RootNamespace>RedAnchorSteam</RootNamespace>
    <!-- Без ICU в системе: языковые таблицы не нужны -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.*" />
  </ItemGroup>

</Project>
